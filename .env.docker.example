# Runtime environment for the Dockerized Next.js app (compose.yaml reads this file).
# Copy to .env.docker and fill in real values. NEVER commit .env.docker.
#
#   PowerShell:  Copy-Item .env.docker.example .env.docker
#   bash:        cp .env.docker.example .env.docker

# --- Required ---------------------------------------------------------------

# PostgreSQL connection string for the EXTERNAL database (Drizzle / `postgres` driver).
# - DB running directly on a Windows/macOS host (not in Docker): use host.docker.internal
#     e.g. postgres://USER:PASSWORD@host.docker.internal:5432/DBNAME
# - Cloud database (Neon, RDS, etc.): use the provider's real hostname.
#     e.g. postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/DBNAME?sslmode=require
# - "localhost" inside a container refers to the container itself, NOT your machine.
# NOTE: the remote DB host must be authorized to accept connections from your
# Docker network / public IP (firewall / allow-list rules).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Secret used to sign/verify auth session tokens (src/lib/auth/token.ts).
# Generate one, e.g. PowerShell:  [Convert]::ToBase64String((1..48 | %{[byte](Get-Random -Max 256)}))
# or bash:  openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string

# --- Optional (defaults shown) -----------------------------------------------

# CORS allow-list for the Next.js proxy (blank = allow none).
CORS_ORIGINS=

# Where uploaded media is written. Keep as-is; the image already has /app/uploads.
UPLOAD_DIR=./uploads
