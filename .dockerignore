# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Git
.git/
.gitignore
.gitattributes

# Local environment files and secrets — never bake into the image.
# NOTE: .env.docker.example is kept out below with an explicit negation.
.env
.env.*
!.env.docker.example
!.env.example

# Test / coverage artifacts
coverage/
*.lcov

# Uploads (runtime data, not build input)
uploads/

# Debug logs and misc
*.log
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*
.DS_Store

# Local dev database files
local-pg/

# Type build info
*.tsbuildinfo
next-env.d.ts
