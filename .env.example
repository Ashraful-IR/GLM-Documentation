# Database Configuration
# PostgreSQL connection string (requires the `ltree` extension / non-public `documentation` schema).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/documentation

# Session signing secret — required by src/lib/auth/session.ts.
# Used to HMAC-sign the stateless `doc_session` cookie. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Optional: media upload dir (defaults to ./uploads)
# UPLOAD_DIR=./uploads

# Optional: comma-separated CORS origins allowed by the dev proxy (defaults: none)
# CORS_ORIGINS=http://localhost:3000

# Optional: base URL used by the verify scripts (defaults: http://localhost:3001)
# BASE_URL=http://localhost:3000
